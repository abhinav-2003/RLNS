FROM node:22-slim

WORKDIR /app

# Install curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy package definitions
COPY package*.json ./

# Install production dependencies
RUN npm install --omit=dev

# Copy server code and shared utilities
COPY split_pdf_by_page.js ./
COPY backend ./backend
COPY frontend ./frontend

# Create directories for persistent database and uploads
RUN mkdir -p /app/data /app/uploads /app/uploads/temp

ENV PORT=5178
ENV HOST=0.0.0.0
ENV NODE_ENV=production
ENV ESTATE_BILLS_DIR=/app/uploads

EXPOSE 5178

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://127.0.0.1:5178/api/health || exit 1

CMD ["node", "backend/server.js"]
